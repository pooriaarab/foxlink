{
  "manifest_version": 3,
  "name": "foxlink — Gmail and Calendar for agents",
  "version": "0.1.3",
  "description": "Connect Gmail and Google Calendar to a Firefox extension with OAuth.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxlink@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "personalCommunications"]
      }
    }
  },
  "permissions": ["identity", "storage", "webRequest", "webRequestBlocking"],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
    "default_title": "foxlink",
    "default_popup": "popup.html"
  }
}
