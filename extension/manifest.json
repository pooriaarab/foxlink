{
  "manifest_version": 3,
  "name": "foxlink demo",
  "version": "0.1.0",
  "description": "Connect Gmail and Google Calendar to a Firefox extension with OAuth.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxlink@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "personalCommunications"]
      }
    }
  },
  "permissions": ["identity", "storage", "webRequest", "webRequestBlocking"],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*",
    "http://*.localhost/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "foxlink demo",
    "default_popup": "popup.html"
  }
}
